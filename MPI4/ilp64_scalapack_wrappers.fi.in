   info = bpack_int(info64)
end subroutine

subroutine bpack_p@P@geqpfmod(m, n, a, ia, ja, desca, ipiv, tau, work, lwork, &
#if @IS_COMPLEX@
                            rwork, lrwork, &
#endif
                            info, jperm, jpiv, rank, rtol, atol)
   integer, intent(in) :: m, n, ia, ja, desca(9), lwork
   integer :: ipiv(*), info, jperm(*), jpiv(*), rank
   @T@ :: a(desca(9),*), tau(*), work(*)
   @R@ :: rtol, atol
#if @IS_COMPLEX@
   integer, intent(in) :: lrwork
   @R@ :: rwork(*)
#endif
   integer(int64), allocatable :: piv(:), perm(:), swaps(:)
   integer(int64) :: info64, rank64
   integer :: npiv, nperm, nswaps, first, last
   logical :: query
   external :: p@P@geqpfmod
   query = lwork == -1
#if @IS_COMPLEX@
   query = query .or. lrwork == -1
#endif
   npiv = 1
   nperm = 1
   nswaps = 1
   if (.not.query) then
      npiv = bpack_p@P@local(int(ja,int64)+int(n,int64)-1_int64,desca,2)
      nperm = bpack_int(int(ja,int64)+int(n,int64)-1_int64)
      nswaps = bpack_int(int(ja,int64)+int(min(m,n),int64)-1_int64)
   end if
   allocate(piv(max(1,npiv)), perm(max(1,nperm)), swaps(max(1,nswaps)))
   piv = 0_int64
   perm = 0_int64
   swaps = 0_int64
   rank64 = 0_int64
   if (.not.query) perm(1:nperm) = int(jperm(1:nperm),int64)
   call p@P@geqpfmod(int(m,int64), int(n,int64), a, int(ia,int64), int(ja,int64), &
      int(desca,int64), piv, tau, work, int(lwork,int64), &
#if @IS_COMPLEX@
      rwork, int(lrwork,int64), &
#endif
      info64, perm, swaps, rank64, rtol, atol)
   info = bpack_int(info64)
   if (.not.query .and. info == 0) then
      first = bpack_int(int(bpack_p@P@local(int(ja,int64)-1_int64,desca,2),int64) + 1_int64)
      ipiv(first:npiv) = bpack_int(piv(first:npiv))
      jperm(1:nperm) = bpack_int(perm(1:nperm))
      rank = bpack_int(rank64)
      last = bpack_int(int(ja,int64)+int(rank,int64)-1_int64)
      jpiv(ja:last) = bpack_int(swaps(ja:last))
   end if
end subroutine

subroutine bpack_p@P@gesvd(jobu, jobvt, m, n, a, ia, ja, desca, s, u, iu, ju, descu, &
                         vt, ivt, jvt, descvt, work, lwork, &
#if @IS_COMPLEX@
                         rwork, &
#endif
                         info)
   character, intent(in) :: jobu, jobvt
   integer, intent(in) :: m, n, ia, ja, iu, ju, ivt, jvt, desca(9), descu(9), descvt(9), lwork
   integer :: info
   @T@ :: a(desca(9),*), u(descu(9),*), vt(descvt(9),*), work(*)
   @R@ :: s(*)
#if @IS_COMPLEX@
   @R@ :: rwork(*)
#endif
   integer(int64) :: info64
   external :: p@P@gesvd
   call p@P@gesvd(jobu, jobvt, int(m,int64), int(n,int64), a, int(ia,int64), &
      int(ja,int64), int(desca,int64), s, u, int(iu,int64), int(ju,int64), int(descu,int64), &
      vt, int(ivt,int64), int(jvt,int64), int(descvt,int64), work, int(lwork,int64), &
#if @IS_COMPLEX@
      rwork, &
#endif
      info64)
   info = bpack_int(info64)
end subroutine

subroutine bpack_p@P@lapiv(direc, rowcol, pivroc, m, n, a, ia, ja, desca, ipiv, ip, jp, descip, iwork)
   character, intent(in) :: direc, rowcol, pivroc
   integer, intent(in) :: m, n, ia, ja, ip, jp, desca(9), descip(9)
   integer :: ipiv(*), iwork(*)
   @T@ :: a(desca(9),*)
   integer(int64), allocatable :: piv(:), iw(:)
   integer(int64) :: extent, nr, nc, ir, ic, gcd_a, gcd_b, remainder, lcm, block, count, extra
   integer(int64), external :: numroc
   integer :: npiv, ndata, nwork, axis
   logical :: rowpivot, colvector, transpose
   external :: p@P@lapiv, blacs_gridinfo
   rowpivot = rowcol == 'R' .or. rowcol == 'r'
   colvector = pivroc == 'C' .or. pivroc == 'c'
   transpose = rowpivot .neqv. colvector
   axis = 2
   if (colvector) axis = 1
   if (.not.transpose) then
      extent = int(ja,int64) + int(n,int64) - 1_int64
      if (rowpivot) extent = int(ia,int64) + int(m,int64) - 1_int64
      ndata = bpack_p@P@local(extent,desca,axis)
      npiv = max(bpack_int(int(ndata,int64) + int(desca(4+axis),int64)), &
         bpack_p@P@local(int(descip(2+axis),int64),descip,axis))
   else
      extent = int(n,int64)
      if (rowpivot) extent = int(m,int64)
      if (colvector) then
         extent = extent + modulo(int(ip,int64)-1_int64,int(descip(5),int64))
      else
         extent = extent + modulo(int(jp,int64)-1_int64,int(descip(6),int64))
      end if
      ndata = bpack_p@P@local(extent,descip,axis)
      npiv = ndata
   end if
   nwork = 1
   if (transpose) then
      call blacs_gridinfo(int(desca(2),int64), nr, nc, ir, ic)
      gcd_a = nr
      gcd_b = nc
      do while (gcd_b /= 0_int64)
         remainder = modulo(gcd_a,gcd_b)
         gcd_a = gcd_b
         gcd_b = remainder
      end do
      lcm = (nr/gcd_a)*nc
      if (rowpivot) then
         block = int(descip(6),int64)
         extent = int(descip(4),int64) + modulo(int(jp,int64)-1_int64,block)
         count = numroc(extent,block,ir,int(desca(7),int64),nr)
         extra = block
         if (nr /= nc) then
            extent = int(bpack_p@P@local(int(descip(4),int64),descip,2),int64)
            extra = block * (((extent+block-1_int64)/block+lcm/nc-1_int64)/(lcm/nc))
         end if
      else
         block = int(descip(5),int64)
         extent = int(descip(3),int64) + modulo(int(ip,int64)-1_int64,block)
         count = numroc(extent,block,ic,int(desca(8),int64),nc)
         extra = block
         if (nr /= nc) then
            extent = int(bpack_p@P@local(int(descip(3),int64),descip,1),int64)
            extra = block * (((extent+block-1_int64)/block+lcm/nr-1_int64)/(lcm/nr))
         end if
      end if
      nwork = bpack_int(count+extra)
   end if
   allocate(piv(max(1,npiv)), iw(max(1,nwork)))
   piv = 0_int64
   iw = 0_int64
   piv(1:ndata) = int(ipiv(1:ndata),int64)
   call p@P@lapiv(direc, rowcol, pivroc, int(m,int64), int(n,int64), a, int(ia,int64), &
      int(ja,int64), int(desca,int64), piv, int(ip,int64), int(jp,int64), int(descip,int64), iw)
   if (transpose) iwork(1:nwork) = bpack_int(iw(1:nwork))
end subroutine

subroutine bpack_p@P@gehrd(n, ilo, ihi, a, ia, ja, desca, tau, work, lwork, info)
   integer, intent(in) :: n, ilo, ihi, ia, ja, desca(9), lwork
   integer :: info
   @T@ :: a(desca(9),*), tau(*), work(*)
   integer(int64) :: info64
   external :: p@P@gehrd
   call p@P@gehrd(int(n,int64), int(ilo,int64), int(ihi,int64), a, int(ia,int64), &
      int(ja,int64), int(desca,int64), tau, work, int(lwork,int64), info64)
   info = bpack_int(info64)
end subroutine

subroutine bpack_p@P@lahqr(wantt, wantz, n, ilo, ihi, a, desca, w, &
#if !@IS_COMPLEX@
                         wi, &
#endif
                         iloz, ihiz, z, descz, work, lwork, iwork, ilwork, info)
   logical, intent(in) :: wantt, wantz
   integer, intent(in) :: n, ilo, ihi, iloz, ihiz, desca(9), descz(9), lwork, ilwork
   integer :: iwork(*), info
   @T@ :: a(desca(9),*), w(*), z(descz(9),*), work(*)
#if !@IS_COMPLEX@
   @R@ :: wi(*)
#endif
   logical(kind=int64) :: wantt64, wantz64
   integer(int64), allocatable :: iw(:)
   integer(int64) :: info64
   external :: p@P@lahqr
   wantt64 = wantt
   wantz64 = wantz
   allocate(iw(max(1,ilwork)))
   iw = 0_int64
   call p@P@lahqr(wantt64, wantz64, int(n,int64), int(ilo,int64), int(ihi,int64), a, &
      int(desca,int64), w, &
#if !@IS_COMPLEX@
      wi, &
#endif
      int(iloz,int64), int(ihiz,int64), z, int(descz,int64), work, int(lwork,int64), &
      iw, int(ilwork,int64), info64)
   info = bpack_int(info64)
   ! LAHQR currently documents IWORK as unreferenced (reserved for future releases).
   if (lwork /= -1 .and. ilwork /= -1) iwork(1:ilwork) = bpack_int(iw(1:ilwork))
end subroutine

#if @IS_COMPLEX@
subroutine bpack_p@P@trevc(side, howmny, select, n, t, desct, vl, descvl, vr, descvr, mm, m, work, rwork, info)
   character, intent(in) :: side, howmny
   integer, intent(in) :: n, desct(9), descvl(9), descvr(9), mm
   logical, intent(in) :: select(*)
   integer :: m, info
   @T@ :: t(desct(9),*), vl(descvl(9),*), vr(descvr(9),*), work(*)
   @R@ :: rwork(*)
   logical(kind=int64), allocatable :: select64(:)
   integer(int64) :: m64, info64
   external :: p@P@trevc
   allocate(select64(max(1,n)))
   select64 = .false.
   if (howmny == 'S' .or. howmny == 's') select64(1:n) = select(1:n)
   call p@P@trevc(side, howmny, select64, int(n,int64), t, int(desct,int64), vl, &
      int(descvl,int64), vr, int(descvr,int64), int(mm,int64), m64, work, rwork, info64)
   info = bpack_int(info64)
   if (info == 0) m = bpack_int(m64)
end subroutine
#endif
