! NUMROC is evaluated in the library's integer kind, including index arithmetic.
integer function bpack_p@P@local(n, desc, axis) result(nlocal)
   integer(int64), intent(in) :: n
   integer, intent(in) :: desc(9), axis
   integer(int64) :: nr, nc, ir, ic, count
   integer(int64), external :: numroc
   external :: blacs_gridinfo
   call blacs_gridinfo(int(desc(2), int64), nr, nc, ir, ic)
   if (axis == 1) then
      count = numroc(max(0_int64, n), int(desc(5), int64), ir, int(desc(7), int64), nr)
   else
      count = numroc(max(0_int64, n), int(desc(6), int64), ic, int(desc(8), int64), nc)
   end if
   nlocal = bpack_int(count)
end function

subroutine bpack_p@P@gemm(transa, transb, m, n, k, alpha, a, ia, ja, desca, &
                         b, ib, jb, descb, beta, c, ic, jc, descc)
   character, intent(in) :: transa, transb
   integer, intent(in) :: m, n, k, ia, ja, ib, jb, ic, jc, desca(9), descb(9), descc(9)
   @T@ :: alpha, beta, a(desca(9),*), b(descb(9),*), c(descc(9),*)
   external :: p@P@gemm
   call p@P@gemm(transa, transb, int(m,int64), int(n,int64), int(k,int64), alpha, &
      a, int(ia,int64), int(ja,int64), int(desca,int64), b, int(ib,int64), int(jb,int64), &
      int(descb,int64), beta, c, int(ic,int64), int(jc,int64), int(descc,int64))
end subroutine

subroutine bpack_p@P@gemr2d(m, n, a, ia, ja, desca, b, ib, jb, descb, ictxt)
   integer, intent(in) :: m, n, ia, ja, ib, jb, desca(9), descb(9), ictxt
   @T@ :: a(desca(9),*), b(descb(9),*)
   external :: p@P@gemr2d
   call p@P@gemr2d(int(m,int64), int(n,int64), a, int(ia,int64), int(ja,int64), &
      int(desca,int64), b, int(ib,int64), int(jb,int64), int(descb,int64), int(ictxt,int64))
end subroutine

subroutine bpack_p@P@trsm(side, uplo, transa, diag, m, n, alpha, a, ia, ja, desca, b, ib, jb, descb)
   character, intent(in) :: side, uplo, transa, diag
   integer, intent(in) :: m, n, ia, ja, ib, jb, desca(9), descb(9)
   @T@ :: alpha, a(desca(9),*), b(descb(9),*)
   external :: p@P@trsm
   call p@P@trsm(side, uplo, transa, diag, int(m,int64), int(n,int64), alpha, a, &
      int(ia,int64), int(ja,int64), int(desca,int64), b, int(ib,int64), int(jb,int64), int(descb,int64))
end subroutine

subroutine bpack_p@P@copy(n, x, ix, jx, descx, incx, y, iy, jy, descy, incy)
   integer, intent(in) :: n, ix, jx, incx, iy, jy, incy, descx(9), descy(9)
   @T@ :: x(*), y(*)
   external :: p@P@copy
   call p@P@copy(int(n,int64), x, int(ix,int64), int(jx,int64), int(descx,int64), &
      int(incx,int64), y, int(iy,int64), int(jy,int64), int(descy,int64), int(incy,int64))
end subroutine

@R@ function bpack_p@P@lange(norm, m, n, a, ia, ja, desca, work) result(value)
   character, intent(in) :: norm
   integer, intent(in) :: m, n, ia, ja, desca(9)
   @T@ :: a(desca(9),*)
   @R@ :: work(*)
   @R@, external :: p@P@lange
   value = p@P@lange(norm, int(m,int64), int(n,int64), a, int(ia,int64), int(ja,int64), &
      int(desca,int64), work)
end function

subroutine bpack_p@P@getrf(m, n, a, ia, ja, desca, ipiv, info)
   integer, intent(in) :: m, n, ia, ja, desca(9)
   integer :: ipiv(*), info
   @T@ :: a(desca(9),*)
   integer(int64), allocatable :: piv(:)
   integer(int64) :: info64
   integer :: first, last, npiv
   external :: p@P@getrf
   npiv = bpack_int(int(bpack_p@P@local(int(desca(3),int64),desca,1),int64) + int(desca(5),int64))
   allocate(piv(max(1,npiv)))
   piv = 0_int64
   call p@P@getrf(int(m,int64), int(n,int64), a, int(ia,int64), int(ja,int64), &
      int(desca,int64), piv, info64)
   info = bpack_int(info64)
   if (info >= 0) then
      first = bpack_int(int(bpack_p@P@local(int(ia,int64)-1_int64,desca,1),int64) + 1_int64)
      last = bpack_p@P@local(int(ia,int64)+int(min(m,n),int64)-1_int64,desca,1)
      ipiv(first:last) = bpack_int(piv(first:last))
   end if
end subroutine

subroutine bpack_p@P@getrfmod(m, n, a, ia, ja, desca, thresh, ipiv, info)
   integer, intent(in) :: m, n, ia, ja, desca(9)
   integer :: ipiv(*), info
   @T@ :: a(desca(9),*)
   @R@ :: thresh
   integer(int64), allocatable :: piv(:)
   integer(int64) :: info64
   integer :: first, last, npiv
   external :: p@P@getrfmod
   npiv = bpack_int(int(bpack_p@P@local(int(desca(3),int64),desca,1),int64) + int(desca(5),int64))
   allocate(piv(max(1,npiv)))
   piv = 0_int64
   call p@P@getrfmod(int(m,int64), int(n,int64), a, int(ia,int64), int(ja,int64), &
      int(desca,int64), thresh, piv, info64)
   info = bpack_int(info64)
   if (info >= 0) then
      first = bpack_int(int(bpack_p@P@local(int(ia,int64)-1_int64,desca,1),int64) + 1_int64)
      last = bpack_p@P@local(int(ia,int64)+int(min(m,n),int64)-1_int64,desca,1)
      ipiv(first:last) = bpack_int(piv(first:last))
   end if
end subroutine

subroutine bpack_p@P@getri(n, a, ia, ja, desca, ipiv, work, lwork, iwork, liwork, info)
   integer, intent(in) :: n, ia, ja, desca(9), ipiv(*), lwork, liwork
   integer :: iwork(*), info
   @T@ :: a(desca(9),*), work(*)
   integer(int64), allocatable :: piv(:), iw(:)
   integer(int64) :: info64
   integer :: npiv, first, last
   logical :: query
   external :: p@P@getri
   query = lwork == -1 .or. liwork == -1
   npiv = 1
   if (.not.query) npiv = bpack_int( &
      int(bpack_p@P@local(int(desca(3),int64),desca,1),int64) + int(desca(5),int64))
   allocate(piv(max(1,npiv)), iw(max(1,liwork)))
   piv = 0_int64
   iw = 0_int64
   if (.not.query) then
      first = bpack_int(int(bpack_p@P@local(int(ia,int64)-1_int64,desca,1),int64) + 1_int64)
      last = bpack_p@P@local(int(ia,int64)+int(n,int64)-1_int64,desca,1)
      piv(first:last) = int(ipiv(first:last),int64)
   end if
   call p@P@getri(int(n,int64), a, int(ia,int64), int(ja,int64), int(desca,int64), &
      piv, work, int(lwork,int64), iw, int(liwork,int64), info64)
   info = bpack_int(info64)
   if (query) then
      if (info == 0) iwork(1) = bpack_int(iw(1))
   else
      iwork(1:liwork) = bpack_int(iw(1:liwork))
   end if
end subroutine

subroutine bpack_p@P@geqrf(m, n, a, ia, ja, desca, tau, work, lwork, info)
   integer, intent(in) :: m, n, ia, ja, desca(9), lwork
